# Smart ATM Operations & Monitoring Platform — environment template
#
# Copy this file to `.env` when wiring a real backend (Phase 17+).
# During the prototype phase, no environment variables are required —
# all data comes from `src/data/` via `src/services/apiClient.js`.

# Future REST API base URL (not used yet)
VITE_API_URL=http://localhost:4000/api

# Future WebSocket URL (not used yet)
VITE_WS_URL=ws://localhost:4000/ws/atm-events

# Simulation defaults (optional overrides)
VITE_SIMULATION_INTERVAL_MS=5000
VITE_SIMULATION_ENABLED=true